# Copy this file to .env.local and fill in your values. .env.local is git-ignored.

# Base URL of your backend API (defaults to http://localhost:8000/api).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Supabase project (Project Settings -> API). Both are public, browser-safe values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
